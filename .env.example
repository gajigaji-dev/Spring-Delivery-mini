# 프로젝트 루트에 .env로 복사한 뒤 값을 채워 사용 (.env는 git에 올리지 않음)
# local 프로필(bootRun·IDE)과 docker-compose가 함께 읽음

# DB 계정 (docker-compose는 이 값으로 PostgreSQL 계정도 생성)
DB_USERNAME=
DB_PASSWORD=

# 선택: docker-compose가 PostgreSQL을 호스트(127.0.0.1)에 여는 포트 (기본 5432)
# 바꾸면 local 실행의 접속 주소(application-local.yml의 localhost:5432)와 달라지므로 SPRING_DATASOURCE_URL도 함께 지정
# DB_PORT=5432

# JWT 서명 키 (필수, Base64 인코딩된 256비트 이상) — 생성 예: openssl rand -base64 32
JWT_SECRET=

# Redis 포트 — 결제 멱등성 키·스케줄러 분산 락 (#41)
# local 실행은 localhost:REDIS_PORT로 접속, docker-compose는 이 포트로 redis 컨테이너를 호스트(127.0.0.1)에 엶
# 6379는 다른 프로젝트 Redis와 겹칠 수 있어 6380 사용. 실행: docker compose up -d redis
REDIS_PORT=6380

# Kafka 포트 — Outbox 이벤트 발행·알림 Consumer (#42)
# local 실행은 localhost:KAFKA_PORT로 접속(KAFKA_BOOTSTRAP_SERVERS 기본값 localhost:9094), docker-compose는 이 포트로 kafka를 호스트(127.0.0.1)에 엶
# 실행: docker compose up -d kafka
# KAFKA_PORT=9094

# 선택: CORS 허용 출처 (쉼표 구분, scheme://host[:port], 와일드카드 불가). local 실행 기본값은 http://localhost:5173,http://localhost:3000
# docker-compose 앱(dev 프로필)은 이 값을 넘기지 않으므로 dev 기본값(위와 같음)을 사용
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# 선택: docker-compose에서 호스트에 여는 애플리케이션 포트 (기본 8080)
# APP_PORT=8080

# 모니터링 프로필(docker compose --profile monitoring up)에서 필수: Grafana admin 비밀번호 (빈 값·admin이면 Grafana가 기동하지 않음)
# GRAFANA_ADMIN_PASSWORD=

# 알림 발송 채널 (#69): log(기본) | slack. slack이면 SLACK_WEBHOOK_URL 필수(없으면 기동 실패)
# 웹훅 URL이 곧 발송 권한 → 실제 값은 .env에만 넣고 이 파일·저장소에는 두지 않음
# NOTIFICATION_SENDER=slack
# SLACK_WEBHOOK_URL=
